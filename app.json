{
  "expo": {
    "name": "Wikipali",
    "slug": "mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:next.wikipali.org",
        "applinks:www.wikipali.org",
        "applinks:next.wikipali.cc",
        "applinks:www.wikipali.cc"
      ]
    },
    "android": {
      "package": "com.iapt.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "next.wikipali.org",
              "pathPrefix": "/library"
            },
            {
              "scheme": "https",
              "host": "www.wikipali.org",
              "pathPrefix": "/library"
            },
            {
              "scheme": "https",
              "host": "next.wikipali.cc",
              "pathPrefix": "/library"
            },
            {
              "scheme": "https",
              "host": "www.wikipali.cc",
              "pathPrefix": "/library"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "97a761eb-3495-419b-aba9-1cc195dd8d5c"
      }
    },
    "owner": "iapt",
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许 WikiPali 取得位置，按当地经纬度计算明相、日中与日暮时间。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 WikiPali 使用相机扫描二维码，打开对应经文。"
        }
      ],
      "expo-share-intent"
    ],
    "scheme": "wikipali"
  }
}
