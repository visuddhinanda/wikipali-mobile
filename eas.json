{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RUNTIME_URL": "https://agent.wikipali.cc/api/copilotkit"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RUNTIME_URL": "https://agent.wikipali.cc/api/copilotkit"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
